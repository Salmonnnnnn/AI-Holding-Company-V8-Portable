# ============================================================================
# AI HOLDING COMPANY V8 — OPTIONAL API KEYS & MT5 CONFIGURATION (.env.example)
# เปลี่ยนชื่อไฟล์นี้เป็น .env หากต้องการเชื่อมต่อ API จริงหรือพอร์ต MT5 จริง
# (หากไม่ใส่ ระบบจะทำงานในโหมด Free Local / Heuristic Simulation 100% ทันที)
# ============================================================================

# 1. LLM API Keys (Optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# 2. MetaTrader 5 (MT5) Terminal Configuration (Optional)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=XAUUSD

# 3. Default Capital & Risk Settings
INITIAL_CAPITAL_USD=1000.0
MAX_RISK_PCT_PER_TRADE=1.5
SERVER_PORT=8080
